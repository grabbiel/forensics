# Optional: copy to .env to override docker compose defaults. Dev-only values, never production.
MSSQL_SA_PASSWORD=DevOnly_Passw0rd!2026
APP_DB_PASSWORD=DevOnly_AppPassw0rd!2026
MSSQL_PORT=1433
# reference (1,000 evidences / 10,000 events) or scale (20,000 / 200,000); applies to a fresh volume.
SEED_PROFILE=reference
# Another SQL Server instead of the mssql container (start with: docker compose up --build --no-deps migrate api web).
# ADMIN_CONNECTION creates the database and the app login; APP_CONNECTION is the API's least-privilege login.
# ADMIN_CONNECTION=Server=host.docker.internal,1433;Database=EvidenceChain;User Id=sa;Password=...;Encrypt=True;TrustServerCertificate=True
# APP_CONNECTION=Server=host.docker.internal,1433;Database=EvidenceChain;User Id=evidence_app;Password=...;Encrypt=True;TrustServerCertificate=True
